{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "backend: build",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/backend/OwnYourSheet.Api/OwnYourSheet.Api.csproj"],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "backend: run",
      "command": "dotnet",
      "type": "process",
      "args": ["run", "--project", "${workspaceFolder}/backend/OwnYourSheet.Api/OwnYourSheet.Api.csproj"],
      "problemMatcher": "$msCompile",
      "isBackground": true
    },
    {
      "label": "frontend: install",
      "type": "shell",
      "command": "npm install",
      "options": { "cwd": "${workspaceFolder}/frontend" }
    },
    {
      "label": "frontend: serve",
      "type": "shell",
      "command": "npx ng serve --proxy-config proxy.conf.json",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*Compiling.*",
          "endsPattern": ".*Compiled successfully.*"
        }
      }
    },
    {
      "label": "start: all",
      "dependsOn": ["backend: run", "frontend: serve"],
      "dependsOrder": "parallel",
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}
